<form class="expense-form" method="post" action="<%= formAction %>" novalidate>
  <div class="form-field form-field-wide">
    <label for="<%= fieldPrefix %>-description">Description</label>
    <input
      id="<%= fieldPrefix %>-description"
      name="description"
      type="text"
      maxlength="120"
      autocomplete="off"
      placeholder="e.g. Weekly groceries"
      value="<%= form.description %>"
      required
      <% if (errors.description) { %>aria-invalid="true" aria-describedby="<%= fieldPrefix %>-description-error"<% } %>
    >
    <% if (errors.description) { %>
      <p class="field-error" id="<%= fieldPrefix %>-description-error"><%= errors.description %></p>
    <% } %>
  </div>

  <div class="form-field">
    <label for="<%= fieldPrefix %>-amount">Amount (USD)</label>
    <input
      id="<%= fieldPrefix %>-amount"
      name="amount"
      type="number"
      min="0.01"
      max="9999999999.99"
      step="0.01"
      inputmode="decimal"
      placeholder="0.00"
      value="<%= form.amount %>"
      required
      <% if (errors.amount) { %>aria-invalid="true" aria-describedby="<%= fieldPrefix %>-amount-error"<% } %>
    >
    <% if (errors.amount) { %>
      <p class="field-error" id="<%= fieldPrefix %>-amount-error"><%= errors.amount %></p>
    <% } %>
  </div>

  <div class="form-field">
    <label for="<%= fieldPrefix %>-category">Category</label>
    <select
      id="<%= fieldPrefix %>-category"
      name="category"
      required
      <% if (errors.category) { %>aria-invalid="true" aria-describedby="<%= fieldPrefix %>-category-error"<% } %>
    >
      <option value="">Choose a category</option>
      <% categories.forEach((category) => { %>
        <option value="<%= category %>" <%= form.category === category ? "selected" : "" %>><%= category %></option>
      <% }); %>
    </select>
    <% if (errors.category) { %>
      <p class="field-error" id="<%= fieldPrefix %>-category-error"><%= errors.category %></p>
    <% } %>
  </div>

  <div class="form-field">
    <label for="<%= fieldPrefix %>-expense-date">Expense date</label>
    <input
      id="<%= fieldPrefix %>-expense-date"
      name="expenseDate"
      type="date"
      value="<%= form.expenseDate %>"
      required
      <% if (errors.expenseDate) { %>aria-invalid="true" aria-describedby="<%= fieldPrefix %>-expense-date-error"<% } %>
    >
    <% if (errors.expenseDate) { %>
      <p class="field-error" id="<%= fieldPrefix %>-expense-date-error"><%= errors.expenseDate %></p>
    <% } %>
  </div>

  <div class="form-actions form-field-wide">
    <% if (cancelHref) { %>
      <a class="button button-secondary" href="<%= cancelHref %>">Cancel</a>
    <% } %>
    <button class="button button-primary" type="submit"><%= submitLabel %></button>
  </div>
</form>
